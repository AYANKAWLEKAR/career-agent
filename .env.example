# --- Database (required once an Autonomous AI Database instance exists) ---
# Directory containing the unzipped Autonomous Database wallet (tnsnames.ora, ewallet.pem, ...)
ORACLE_TNS_ADMIN=/path/to/wallet
# Service alias from tnsnames.ora, e.g. mydb_low
ORACLE_DSN=mydb_low
# Database schema user created for the application
ORACLE_USER=navigator
# Password for ORACLE_USER
ORACLE_PASSWORD=change-me
# Password protecting the wallet (set when the wallet was downloaded from OCI)
ORACLE_WALLET_PASSWORD=change-me

# --- OCI (optional in this phase; from ~/.oci/config or the OCI console) ---
# Tenancy OCID from the OCI console
OCI_TENANCY=
# User OCID from the OCI console
OCI_USER=
# API signing key fingerprint from the OCI console
OCI_FINGERPRINT=
# Home region identifier, e.g. us-ashburn-1
OCI_REGION=
# Compartment OCID holding the database instance
OCI_COMPARTMENT_ID=
# Path to the API signing private key file
OCI_KEY_FILE=

# --- Data sources (optional except CareerOneStop) ---
# O*NET Web Services v2 API key; register at https://services.onetcenter.org/developer/signup
ONET_API_KEY=
# CareerOneStop user ID; register at https://www.careeronestop.org/Developers/WebAPI/registration.aspx
CAREERONESTOP_USER_ID=
# CareerOneStop API token issued with the user ID above
CAREERONESTOP_TOKEN=
# College Scorecard API key from https://api.data.gov/signup/
SCORECARD_API_KEY=
# BLS API key from https://data.bls.gov/registrationEngine/ (unused this phase; bulk files preferred)
BLS_API_KEY=

# --- LLM (resume parsing and path narration) ---
# 'ollama' runs a local model (default; needs an ollama server on this machine);
# 'anthropic' uses the Claude API and needs ANTHROPIC_API_KEY.
LLM_BACKEND=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=

# --- Application ---
# Demo mode flag; defaults to true
DEMO_MODE=true
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Connection pool sizing
POOL_MIN=1
POOL_MAX=4
POOL_INCREMENT=1

# Wage display scope: national | bay | alameda (penalty always national)
WAGE_SCOPE=national
